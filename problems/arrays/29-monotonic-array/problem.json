    "Google"
  ],
  "description": "Return true if `nums` is entirely non-decreasing or entirely non-increasing. Equal adjacent values are allowed.\n\nInput: an integer array `nums`. Return the result described above.",
  "constraints": [
    "1 <= nums.length <= 10^4",
    "-2^31 <= nums[i] <= 2^31 - 1"
  ],
  "hints": [
    "Track the relevant ordering or candidate values in one pass where possible.",
    "Check duplicate and boundary cases."
  ],
  "examples": [
    {
      "input": "nums = [1, 2, 2, 3]",
      "output": "true"
    },
    {
      "input": "nums = [1, 3, 2]",
      "output": "false"
    }
  ],
  "timeComplexity": "O(n)",
  "spaceComplexity": "O(1)",
  "compare": "exact",
  "signature": {
    "kind": "function",
    "method": "isMonotonic",
    "params": [
      {
        "name": "nums",
        "type": "int[]"
      }
    ],
    "returns": "boolean"
  }
}
