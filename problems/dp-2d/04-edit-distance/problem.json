{
  "title": "Edit Distance",
  "difficulty": "Medium",
  "subtopic": "String Edits",
  "companies": [
    "Amazon",
    "Google",
    "Microsoft"
  ],
  "description": "Return the minimum number of single-character insertions, deletions, or substitutions needed to transform `word1` into `word2`.",
  "constraints": [
    "0 <= word1.length, word2.length <= 500",
    "Strings contain lowercase English letters"
  ],
  "hints": [
    "Define the state as the best answer for a prefix or cell.",
    "Update from the previous row or previous prefix while preserving the recurrence."
  ],
  "examples": [
    {
      "input": "word1 = \"horse\", word2 = \"ros\"",
      "output": "3"
    }
  ],
  "timeComplexity": "O(m*n)",
  "spaceComplexity": "O(n)",
  "compare": "exact",
  "signature": {
    "kind": "function",
    "method": "minDistance",
    "params": [
      {
        "name": "word1",
        "type": "String"
      },
      {
        "name": "word2",
        "type": "String"
      }
    ],
    "returns": "int"
  }
}
